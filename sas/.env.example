# Frontend Environment Configuration
# Copy this file to .env and update values for your environment

# API Configuration
API_ENV=development
# Options: development, staging, production

# API Base URL - Choose ONE option below:

# Option 1: Local Development (Simulator/Web):
API_BASE_URL=http://localhost:5000/api

# Option 2: Android Emulator (replace localhost with 10.0.2.2):
# API_BASE_URL=http://10.0.2.2:5000/api

# Option 3: Physical Device - Local Network (find IP with: ipconfig):
# API_BASE_URL=http://192.168.1.100:5000/api

# Option 4: Physical Device - Via ngrok (Internet):
# Get free account at https://ngrok.com/
# Start ngrok tunnel: ngrok http 5000
# Copy the HTTPS URL and use it here:
# API_BASE_URL=https://YOUR_NGROK_URL/api
# Example:
# API_BASE_URL=https://cloudier-lorretta-charmedly.ngrok-free.dev/api

# Timeout (in milliseconds)
API_TIMEOUT=10000

# Application Settings
APP_NAME=SAS (Student Attendance System)
APP_VERSION=1.0.0

# Feature Flags
ENABLE_MOCK_DATA=false
ENABLE_DEBUGGING=true

# Authentication
AUTH_TOKEN_KEY=sas_auth_token
AUTH_REFRESH_INTERVAL=25m

# Troubleshooting: If you see "Network request failed"
# 1. Make sure API_BASE_URL matches your setup
# 2. Verify backend is running: npm start (in backend folder)
# 3. Clear Expo cache: npm start -- --reset-cache
# 4. Restart the app completely (not just reopen)
# 5. If using ngrok, ensure tunnel is still active
# See NETWORK_FIX_GUIDE.md for detailed steps
