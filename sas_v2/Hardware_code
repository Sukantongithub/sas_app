#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <DNSServer.h>
#include <Wire.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_ADXL345_U.h>

// ================= CONFIG =================
#define DEVICE_ID "ID_001"

const byte DNS_PORT = 53;
DNSServer dnsServer;
ESP8266WebServer server(80);

// ADXL345
Adafruit_ADXL345_Unified accel = Adafruit_ADXL345_Unified(12345);

String ssid = "";
String password = "";
String backendIP = "";

bool wifiConnected = false;

unsigned long lastSend = 0;
const int sendInterval = 2000;

// HTML
const char PAGE[] PROGMEM = R"rawliteral(
<h2>ESP8266 Setup</h2>
<form action='/connect'>
WiFi SSID: <input name='s'><br>
WiFi Password: <input name='p'><br>
Backend IP (192.168.1.5:5000): <input name='ip'><br>
<input type='submit'>
</form>
)rawliteral";

// ================= SETUP =================
void setup() {
  Serial.begin(115200);
  Wire.begin();

  if(!accel.begin())
  {
    Serial.println("ADXL345 not detected");
    while(1);
  }

  accel.setRange(ADXL345_RANGE_16_G);

  WiFi.softAP("ESP8266-Setup", "12345678");
  dnsServer.start(DNS_PORT, "*", WiFi.softAPIP());

  server.on("/", handleRoot);
  server.on("/connect", handleConnect);
  server.begin();
}

// ================= LOOP =================
void loop() {

  if (!wifiConnected) {
    dnsServer.processNextRequest();
    server.handleClient();
    return;
  }

  if (WiFi.status() != WL_CONNECTED) {
    WiFi.reconnect();
    delay(1000);
    return;
  }

  if (millis() - lastSend > sendInterval) {
    sendData();
    lastSend = millis();
  }
}

// ================= WEB =================
void handleRoot() {
  server.send(200, "text/html", PAGE);
}

void handleConnect() {

  ssid = server.arg("s");
  password = server.arg("p");
  backendIP = server.arg("ip");

  server.send(200, "text/html", "Connecting...");

  WiFi.softAPdisconnect(true);
  WiFi.begin(ssid.c_str(), password.c_str());

  int timeout = 20;
  while (WiFi.status() != WL_CONNECTED && timeout--) {
    delay(500);
  }

  if (WiFi.status() == WL_CONNECTED) {
    wifiConnected = true;
  }
}

// ================= SEND DATA =================
void sendData() {

  sensors_event_t event;
  accel.getEvent(&event);

  float ax = event.acceleration.x;
  float ay = event.acceleration.y;
  float az = event.acceleration.z;

  // motion intensity
  float motion = abs(ax) + abs(ay) + abs(az);

  int rssi = WiFi.RSSI();

  String json = "{";
  json += "\"id\":\"" + String(DEVICE_ID) + "\",";
  json += "\"ax\":" + String(ax) + ",";
  json += "\"ay\":" + String(ay) + ",";
  json += "\"az\":" + String(az) + ",";
  json += "\"m\":" + String(motion) + ",";
  json += "\"r\":" + String(rssi);
  json += "}";

  WiFiClient client;

  String host = backendIP;
  int port = 80;

  int colonIndex = backendIP.indexOf(':');
  if (colonIndex != -1) {
    host = backendIP.substring(0, colonIndex);
    port = backendIP.substring(colonIndex + 1).toInt();
  }

  if (!client.connect(host.c_str(), port)) {
    return;
  }

  client.println("POST /gyro HTTP/1.1");
  client.println("Host: " + host);
  client.println("Content-Type: application/json");
  client.print("Content-Length: ");
  client.println(json.length());
  client.println();
  client.println(json);

  delay(10);
  client.stop();
}
