# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and update values for your environment
# DO NOT commit .env to version control - it contains sensitive data
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Options: development, staging, production

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# Local MongoDB instance (development)
MONGODB_URI=mongodb://localhost:27017/attendance_db

# MongoDB Atlas cloud (production - uncomment and update credentials)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/attendance_db?retryWrites=true&w=majority

# ──────────────────────────────────────────────────────────────────────────────
# JWT (JSON Web Token) CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=30d

# ──────────────────────────────────────────────────────────────────────────────
# DEVICE ENCRYPTION CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
# Must be exactly 16 characters (128-bit key)
DEVICE_ENCRYPTION_KEY=1234567890abcdef

# ──────────────────────────────────────────────────────────────────────────────
# INITIAL USER SETUP (for createTestUser.js script)
# ──────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Change these credentials before running the setup script
# These are used ONLY for initial database setup

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-secure-password
ADMIN_NAME=System Administrator

TEACHER_EMAIL=teacher@yourdomain.com
TEACHER_PASSWORD=change-this-secure-password
TEACHER_NAME=Teacher Name

STUDENT_EMAIL=student@yourdomain.com
STUDENT_PASSWORD=change-this-secure-password
STUDENT_NAME=Student Name

# ──────────────────────────────────────────────────────────────────────────────
# CORS CONFIGURATION (Optional)
# ──────────────────────────────────────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Email/Notification Configuration (Optional)
# ──────────────────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password

# ──────────────────────────────────────────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────────────────────────────────────────
ENABLE_MOCK_DATA=false
DEBUG_MODE=true

STUDENT_NAME=Student Name
