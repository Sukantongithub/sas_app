# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/attendance_db
# Or use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/attendance_db

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=30d

# Device Encryption
DEVICE_ENCRYPTION_KEY=your-16-char-key-change-in-production

# Initial User Setup (for createTestUser.js script)
# IMPORTANT: Change these credentials before running the script
# Admin User (Required)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-secure-password
ADMIN_NAME=System Administrator

# Teacher User (Optional)
TEACHER_EMAIL=teacher@yourdomain.com
TEACHER_PASSWORD=change-this-secure-password
TEACHER_NAME=Teacher Name

# Student User (Optional)
STUDENT_EMAIL=student@yourdomain.com
STUDENT_PASSWORD=change-this-secure-password
STUDENT_NAME=Student Name
